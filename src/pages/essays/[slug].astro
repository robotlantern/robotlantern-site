---
// Essay page: ported from the Shopify prototype's journal page (regular view, contribution
// highlighting, "Inside this post", Exact Markdown, contributor footer), restyled for the night.
import fs from 'node:fs';
import crypto from 'node:crypto';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { renderTree, toHTML, type Attribution } from '../../lib/markdown';

export async function getStaticPaths() {
  const entries = await getCollection('essays');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Totals = Record<string, { chars: number; authors: Record<string, { chars: number; percent: number }>; copyedits: Record<string, { edits: number; chars: number }> }>;
type Version = { n: number; author: string; role: string; label: string };

const { entry } = Astro.props;
const dir = `src/content/essays/${entry.id}`;
const md = fs.readFileSync(`${dir}/article.md`, 'utf8');
const attribution: Attribution & { article_sha256: string; totals: Totals; versions: Version[] } = JSON.parse(
  fs.readFileSync(`${dir}/attribution.json`, 'utf8'),
);
const sha = crypto.createHash('sha256').update(md).digest('hex');
if (sha !== attribution.article_sha256) {
  throw new Error(`${dir}: attribution.json was made for a different article.md. Rerun tools/attribution.`);
}

// The article's own H1 becomes the page title, keeping its highlighting.
const tree = await renderTree(md, { attribution });
const h1Index = tree.children!.findIndex((n) => n.type === 'element' && n.tagName === 'h1');
const [h1] = h1Index >= 0 ? tree.children!.splice(h1Index, 1) : [];
const titleHtml = h1 ? toHTML(h1.children!) : entry.data.title;
const bodyHtml = toHTML(tree);

const people = attribution.participants;
const name = Object.fromEntries(people.map((p) => [p.id, p.name]));
const authors = people.filter((p) => p.kind === 'human').map((p) => p.name).join(' and ');
const sections = Object.entries(attribution.totals);
const sectionName = (s: string) => (s === 'body' ? 'Essay' : s[0].toUpperCase() + s.slice(1));
const drafts = attribution.versions.filter((v) => v.role !== 'message');
const inside = fs.existsSync(`${dir}/inside.json`) ? fs.readFileSync(`${dir}/inside.json`, 'utf8') : null;
const when = entry.data.date?.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={entry.data.title} section="essays">
  <main class="essay reading">
    <header class="essay__head">
      <p class="kicker">Essay</p>
      <h1 set:html={titleHtml} data-article />
      <p class="meta">{when && <><time datetime={entry.data.date!.toISOString().slice(0, 10)}>{when}</time> · </>}{authors}</p>
    </header>

    <div class="essay__controls" aria-label="Article views">
      <button class="control" type="button" aria-pressed="false" data-contributions>Show contributions</button>
      <button class="control" type="button" aria-expanded="false" aria-controls="inside-this-post" data-inside-toggle>Inside this post</button>
      <a class="control" href={`/essays/${entry.id}/article.md`}>Exact Markdown</a>
    </div>

    <p class="essay__legend" data-legend hidden>
      {people.map((p) => <span class={`w w-${p.kind}`}>{p.name}</span>)}
      <span class="w w-human w-ce">copyedited</span>
    </p>

    <article class="essay__body prose" data-article set:html={bodyHtml} />

    <section class="inside" id="inside-this-post" data-inside hidden>
      <h2>Inside this post</h2>
      <p>How the essay got here: each full draft in order, and who made it. The attribution counts come from comparing them.</p>
      <ol class="inside__drafts">
        {drafts.map((v) => <li>{v.label}{v.role === 'copyedit' ? ' (copyedit)' : ''} <span class={`inside__who inside__who--${people.find((p) => p.id === v.author)?.kind}`}>· {name[v.author]}</span></li>)}
      </ol>
      {inside ? (
        <>
          <button class="control" type="button" aria-pressed="false" data-json-wrap>Wrap JSON</button>
          <pre class="inside__json" tabindex="0">{inside}</pre>
        </>
      ) : (
        <p class="inside__pending">The full editing conversation will appear here once it has been reviewed for publication.</p>
      )}
    </section>

    <footer class="contributors">
      {people.map((p) => (
        <div class={`contributors__person contributors__person--${p.kind}`}>
          <strong>{p.name}</strong> <span>{p.kind === 'human' ? 'human author' : 'AI collaborator'}</span>
          <ul>
            {sections.map(([s, t]) => {
              const share = t.authors[p.id];
              const edits = t.copyedits[p.id];
              return (
                <li>
                  {sectionName(s)}: {share ? `${share.percent}% of the words` : 'none'}
                  {edits && ` · ${edits.edits} copyedit${edits.edits === 1 ? '' : 's'}`}
                </li>
              );
            })}
          </ul>
        </div>
      ))}
      <p class="contributors__note">Counted character by character from the drafts. The essay and its footnotes are counted separately. Copyedits keep the original author’s credit (see “Inside this post”).</p>
    </footer>
  </main>
</Base>

<style>
  .essay { padding-block: 2rem 1rem; }
  .essay__head { padding-bottom: 1.4rem; border-bottom: 1px solid var(--line); }
  .essay__head h1 { margin: .4rem 0 .9rem; font: 400 clamp(2.4rem, 7vw, 4rem)/1.02 var(--serif); letter-spacing: -.035em; }
  .essay__controls { position: sticky; top: 0; z-index: 5; display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.2rem 0 1.6rem; padding: .6rem 0; background: rgba(4, 6, 13, .88); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .essay__legend { display: flex; flex-wrap: wrap; gap: .6rem; margin: -.8rem 0 1.4rem; font: .76rem/1.8 var(--sans); }
  .essay__legend[hidden] { display: none; }
  .essay__legend .w { padding: 0 .4rem; }
  .essay__body { font-size: 1.16rem; line-height: 1.85; }
  .essay__body :global(h2) { margin-top: 3rem; padding-top: 1.4rem; border-top: 1px solid var(--line); font-size: 1.3rem; }
  .essay__body :global(h2 ~ p) { font-size: .96rem; line-height: 1.75; color: var(--muted); }
  .essay__body :global(sup) { line-height: 0; font: 600 .68rem/0 var(--sans); }
  .essay__body :global(sup a) { text-decoration: none; }

  /* Contribution highlighting: off until the reader asks for it. */
  :global(.w) { -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  :global(.contributions .w-human), .essay__legend :global(.w-human) { background: rgba(240, 160, 64, .24); color: #ffe7c4; }
  :global(.contributions .w-ai), .essay__legend :global(.w-ai) { background: rgba(106, 170, 242, .26); color: #dcebff; }
  :global(.contributions .w-ce), .essay__legend :global(.w-ce) { text-decoration: underline dotted rgba(255, 255, 255, .7); text-underline-offset: .2em; }
  :global(.contributions .w-unknown) { background: rgba(190, 190, 190, .2); }

  .inside { margin: 1rem 0 2rem; }
  .inside h2 { margin: 0 0 .6rem; font: 400 1.8rem/1.1 var(--serif); }
  .inside > p { color: var(--muted); font: 1rem/1.6 var(--serif); }
  .inside__drafts { padding-left: 1.4rem; font: .9rem/1.8 var(--sans); }
  .inside__who { font-size: .8rem; }
  .inside__who--human { color: var(--human); }
  .inside__who--ai { color: var(--ai); }
  .inside__pending { padding: .6rem .9rem; border-left: 2px solid var(--ember); background: rgba(240, 160, 64, .06); font: .85rem/1.6 var(--sans) !important; }
  .inside__json { max-height: 70vh; overflow: auto; margin-top: .8rem; padding: 1rem; border: 1px solid var(--line); background: rgba(2, 4, 10, .6); font: .78rem/1.6 var(--mono); white-space: pre; }
  .inside__json.wrapped { white-space: pre-wrap; overflow-wrap: anywhere; }

  .contributors { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem 2rem; margin-top: 3rem; padding-top: 1.2rem; border-top: 1px solid var(--line); color: var(--muted); font: .82rem/1.6 var(--sans); }
  .contributors ul { margin: .3rem 0 0; padding: 0; list-style: none; }
  .contributors__person--human strong { color: var(--human); }
  .contributors__person--ai strong { color: var(--ai); }
  .contributors__note { grid-column: 1 / -1; margin: 0; color: var(--faint); font-size: .76rem; }
</style>

<script>
  const articles = document.querySelectorAll<HTMLElement>('[data-article]');
  const legend = document.querySelector<HTMLElement>('[data-legend]');
  const body = document.querySelector<HTMLElement>('article[data-article]');
  const inside = document.querySelector<HTMLElement>('[data-inside]');
  const contributions = document.querySelector<HTMLButtonElement>('[data-contributions]');
  const insideToggle = document.querySelector<HTMLButtonElement>('[data-inside-toggle]');

  contributions?.addEventListener('click', () => {
    const on = contributions.getAttribute('aria-pressed') !== 'true';
    contributions.setAttribute('aria-pressed', String(on));
    contributions.textContent = on ? 'Hide contributions' : 'Show contributions';
    articles.forEach((a) => a.classList.toggle('contributions', on));
    if (legend) legend.hidden = !on;
  });

  const showInside = (on: boolean) => {
    if (!insideToggle || !body || !inside) return;
    insideToggle.setAttribute('aria-expanded', String(on));
    insideToggle.textContent = on ? 'Read the essay' : 'Inside this post';
    body.hidden = on;
    inside.hidden = !on;
    if (contributions) contributions.disabled = on;
    if (legend && on) legend.hidden = true;
    else if (legend) legend.hidden = contributions?.getAttribute('aria-pressed') !== 'true';
  };
  insideToggle?.addEventListener('click', () => showInside(insideToggle.getAttribute('aria-expanded') !== 'true'));
  if (location.hash === '#inside-this-post') showInside(true);

  const wrap = document.querySelector<HTMLButtonElement>('[data-json-wrap]');
  wrap?.addEventListener('click', () => {
    const on = wrap.getAttribute('aria-pressed') !== 'true';
    wrap.setAttribute('aria-pressed', String(on));
    document.querySelector('.inside__json')?.classList.toggle('wrapped', on);
  });
</script>
