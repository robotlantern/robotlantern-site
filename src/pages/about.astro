---
// About: what Robot Lantern is, and the cast of machines that make it. Linked from the footer.
// The machines' names come from books; the page doesn't explain which character is which.
import Base from '../layouts/Base.astro';

type Member = { name: string; what: string; line: string; icon: string };
const cast: Member[] = [
  { name: 'Sarcean', what: 'MacBook Pro', line: 'The workstation. Everything here is written, built and argued over on it first.', icon: 'laptop' },
  { name: 'Samwise', what: 'Raspberry Pi 5', line: 'The home server. It carries the previews, the media and the house’s services on a 2 TB drive, and doesn’t complain.', icon: 'pi' },
  { name: 'Scout', what: '2013 MacBook Air', line: 'Revived with a new drive and sent ahead to run agents. Lives on Wi-Fi.', icon: 'wedge' },
  { name: 'InkBot Alpha, Beta and Delta', what: 'Printers', line: 'Ink on paper, three ways.', icon: 'αβδ' },
  { name: 'MeltBot', what: '3D printer', line: 'Melts plastic into shapes, one layer at a time.', icon: 'melt' },
  { name: 'CutBot', what: 'Cricut', line: 'Cuts shapes out of flat things.', icon: 'cut' },
];
---
<Base title="About" description="What Robot Lantern is, and the cast of machines that make it.">
  <main class="reading about">
    <h1>About</h1>
    <div class="prose">
      <p>Robot Lantern is RJ’s workshop, in public. <a href="/thoughts/">Thoughts</a> are essays. <a href="/chats/">Chats</a> are conversations with AI models that are worth reading on their own. <a href="/builds/">Builds</a> are interactive projects, and the <a href="/shop/">shop</a> sells prints made from Robot Lantern’s art.</p>
      <p>Much of it is written with AI models, and every piece says so: essays show who wrote which words, and chats show who said what. The people and models who write here are on the <a href="/authors/">authors</a> page.</p>
    </div>

    <h2>The cast</h2>
    <p class="lede">The machines that make Robot Lantern have names.</p>
    <ul class="cast">
      {cast.map((m) => (
        <li>
          <svg class="cast__icon" viewBox="0 0 48 48" aria-hidden="true">
            {m.icon === 'laptop' && <>
              <rect x="9" y="10" width="30" height="21" rx="2" />
              <path d="M4 35h40l-2.5 3h-35z" />
              <path class="spark" d="M24 17.5v6M21.4 19l5.2 3M21.4 22l5.2-3" />
            </>}
            {m.icon === 'pi' && <>
              <rect x="5" y="12" width="36" height="25" rx="2.5" />
              <path class="dots" d="M9 16h26" />
              <rect x="17" y="21" width="10" height="10" rx="1" />
              <path d="M41 19h3v5h-3M41 27h3v5h-3M9 37v3M14 37v3" />
            </>}
            {m.icon === 'wedge' && <>
              <path d="M5 38h37v-2.2z" />
              <path d="M41.2 35.2 33.5 11.5l-1.6.5 7.6 23.6" />
              <path class="thin" d="M12 18a10 10 0 0 1 14 0M15 21.5a5.5 5.5 0 0 1 8 0" />
              <circle class="fill" cx="19" cy="25" r="1.3" />
            </>}
            {m.icon === 'αβδ' && <>
              <path d="M14 18V9h20v9" />
              <rect x="7" y="18" width="34" height="14" rx="2.5" />
              <path d="M14 32v8h20v-8" />
              <circle class="fill" cx="35" cy="23" r="1.2" />
              <text x="24" y="38.6" text-anchor="middle">{m.icon}</text>
            </>}
            {m.icon === 'melt' && <>
              <path d="M8 42V6h32v36" />
              <path d="M8 15h32" />
              <path d="M21 15h6l-3 5z" />
              <path d="M6 38h36" />
              <path class="thin" d="M18 38v-8h12v8M18 35.3h12M18 32.6h12" />
            </>}
            {m.icon === 'cut' && <>
              <rect x="6" y="18" width="36" height="12" rx="6" />
              <path d="M2 33h44" />
              <path d="M21 18v-4h6v4M24 18v5" />
              <path class="thin dashes" d="M8 39h32" />
            </>}
          </svg>
          <div>
            <h3>{m.name}</h3>
            <p class="cast__what">{m.what}</p>
            <p>{m.line}</p>
          </div>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .about { padding-block: 2.5rem 1rem; }
  h1 { margin: 0 0 1.5rem; font: 400 2.4rem/1 var(--serif); }
  h2 { margin: 3rem 0 .4rem; font: 400 1.7rem/1.1 var(--serif); }
  .lede { margin: 0 0 1.6rem; color: var(--muted); font: 1rem/1.6 var(--serif); }
  .cast { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .cast li { display: flex; gap: 1rem; padding: 1.1rem 1.2rem; border-radius: 1rem; background: rgba(8, 15, 33, .6); }
  .cast__icon { flex: none; width: 3rem; height: 3rem; color: var(--lantern); fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .cast__icon .thin { stroke-width: 1.1; }
  .cast__icon .dots { stroke-dasharray: 1.4 2.2; stroke-width: 2; }
  .cast__icon .dashes { stroke-dasharray: 2.5 2; }
  .cast__icon .fill { fill: currentColor; stroke: none; }
  .cast__icon .spark { stroke-width: 1.3; opacity: .85; }
  .cast__icon text { fill: currentColor; stroke: none; font: italic 8px/1 var(--serif); }
  h3 { margin: 0; font: 400 1.25rem/1.2 var(--serif); }
  .cast__what { margin: .15rem 0 .45rem; color: var(--faint); font: .72rem/1.2 var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  .cast p:last-child { margin: 0; color: var(--muted); font: .95rem/1.5 var(--serif); }
</style>
