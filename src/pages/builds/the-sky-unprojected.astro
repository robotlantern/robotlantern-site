---
// "The Sky, Unprojected": the interactive from the unprojection-opus repo, full screen. Its build
// is copied into public/sky/ (that repo's docs/EMBEDDING.md); this page only mounts it.
import BuildLayout from '../../layouts/BuildLayout.astro';
---
<BuildLayout title="The Sky, Unprojected" description="RJ's photo of the Pleiades and their neighbors, unfolded into where everything really is.">
  <main id="sky" class="sky"></main>
  <script is:inline type="module">
    import { mount } from '/sky/assets/unprojection.js';
    const params = new URLSearchParams(location.search);
    mount(document.getElementById('sky'), {
      object: params.get('object') || undefined,
      view: params.get('view') || undefined,
      updateUrl: true,
    });
  </script>
</BuildLayout>

<style>
  /* The module fills its box: the whole screen. */
  .sky { height: 100vh; height: 100dvh; }
</style>
