---
// A test bench for the ornament's preview module (src/scripts/shop/lithophane-bulb.js), checked at phone
// size. The real product page is the configurator (NOW.md step 10). Not in the sitemap, not indexed, and
// it goes before launch (step 20).
import Base from '../../../layouts/Base.astro';
---
<Base title="Ornament preview test">
  <meta slot="head" name="robots" content="noindex">
  <main class="bench">
    <canvas id="ornament" aria-label="The ornament with your photo"></canvas>
    <p class="note" id="note" aria-live="polite"></p>

    <div class="seg" role="radiogroup" aria-label="Lights">
      <button type="button" data-lit="1" aria-pressed="true">On</button>
      <button type="button" data-lit="0" aria-pressed="false">Off</button>
    </div>
    <div class="seg" role="radiogroup" aria-label="Your tree lights">
      <button type="button" data-light="mini" aria-pressed="true">Mini LED</button>
      <button type="button" data-light="c7" aria-pressed="false">C7</button>
      <button type="button" data-light="c9" aria-pressed="false">C9</button>
    </div>
    <label class="zoom"><span>Zoom</span><input id="zoom" type="range" min="1" max="4" step="0.01" value="1"></label>
    <div class="row">
      <label class="pick">Choose a photo<input id="file" type="file" accept="image/*"></label>
      <button type="button" id="card">Test card</button>
      <button type="button" id="night">Night photo</button>
    </div>
    <p class="timing" id="timing"></p>
  </main>
</Base>

<script>
  import { createOrnamentPreview } from '../../../scripts/shop/lithophane-bulb.js';

  const canvas = document.getElementById('ornament') as HTMLCanvasElement;
  const note = document.getElementById('note')!;
  const timing = document.getElementById('timing')!;
  const zoom = document.getElementById('zoom') as HTMLInputElement;
  const preview = createOrnamentPreview(canvas, { light: 'mini', cap: 'gold' });

  // The crop: a square in the photo, as fractions; zoom shrinks it, dragging moves it.
  let cx = 0.5, cy = 0.5;
  function crop() {
    const size = preview.photoSize;
    if (!size) return null;
    const side = Math.min(size.width, size.height) / Number(zoom.value);
    const half = side / 2;
    const x = Math.min(Math.max(cx * size.width, half), size.width - half);
    const y = Math.min(Math.max(cy * size.height, half), size.height - half);
    cx = x / size.width; cy = y / size.height;
    return { x: (x - half) / size.width, y: (y - half) / size.height, w: side / size.width, h: side / size.height };
  }
  function timed(fn: () => void) {
    const t = performance.now();
    fn();
    timing.textContent = `${Math.round(performance.now() - t)} ms`;
    const c = preview.check();
    note.textContent = !c ? '' : c.dark ? 'This photo is dark. A brighter one will show more.'
      : c.flat ? 'This photo is low in contrast. Faces need light and shadow.' : '';
  }
  async function show(photo: Blob | HTMLCanvasElement | HTMLImageElement) {
    await preview.setPhoto(photo);
    cx = cy = 0.5; zoom.value = '1';
    timed(() => preview.setCrop(crop()));
  }

  // A drawn test card: a grey wedge, a gradient and a face, so tone can be judged without a photo.
  function testCard() {
    const c = document.createElement('canvas');
    c.width = c.height = 900;
    const g = c.getContext('2d')!;
    const sky = g.createLinearGradient(0, 0, 0, 900);
    sky.addColorStop(0, '#f6d9a8'); sky.addColorStop(1, '#2a3550');
    g.fillStyle = sky; g.fillRect(0, 0, 900, 900);
    for (let i = 0; i < 10; i++) { g.fillStyle = `hsl(0 0% ${i * 11}%)`; g.fillRect(150 + i * 60, 700, 60, 90); }
    g.fillStyle = '#e8c6a8'; g.beginPath(); g.ellipse(450, 390, 170, 210, 0, 0, Math.PI * 2); g.fill();
    g.fillStyle = '#3a2618'; g.beginPath(); g.ellipse(450, 230, 185, 95, 0, Math.PI, Math.PI * 2); g.fill();
    g.fillStyle = '#2b1d14';
    for (const x of [385, 515]) { g.beginPath(); g.arc(x, 370, 18, 0, Math.PI * 2); g.fill(); }
    g.lineWidth = 12; g.strokeStyle = '#7a3b2e'; g.beginPath(); g.arc(450, 450, 70, 0.15 * Math.PI, 0.85 * Math.PI); g.stroke();
    return c;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-lit], [data-light]').forEach((b) => b.addEventListener('click', () => {
    b.parentElement!.querySelectorAll('button').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    timed(() => preview.set(b.dataset.light ? { light: b.dataset.light } : { lit: b.dataset.lit === '1' }));
  }));
  zoom.addEventListener('input', () => preview.setCrop(crop(), { draft: true }));
  zoom.addEventListener('change', () => timed(() => preview.setCrop(crop())));
  (document.getElementById('file') as HTMLInputElement).addEventListener('change', (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (f) show(f);
  });
  document.getElementById('card')!.addEventListener('click', () => show(testCard()));
  document.getElementById('night')!.addEventListener('click', async () => {
    show(await (await fetch('/images/night.jpg')).blob());
  });

  // Drag the photo inside its circle.
  let drag: { x: number; y: number } | null = null;
  let queued = false;
  canvas.addEventListener('pointerdown', (e) => { drag = { x: e.clientX, y: e.clientY }; canvas.setPointerCapture(e.pointerId); });
  canvas.addEventListener('pointermove', (e) => {
    const size = preview.photoSize;
    if (!drag || !size) return;
    const side = Math.min(size.width, size.height) / Number(zoom.value);
    const perPx = side / (preview.circle.d * canvas.clientWidth);    // photo pixels per CSS pixel
    cx -= ((e.clientX - drag.x) * perPx) / size.width;
    cy -= ((e.clientY - drag.y) * perPx) / size.height;
    drag = { x: e.clientX, y: e.clientY };
    if (!queued) {
      queued = true;
      requestAnimationFrame(() => { queued = false; preview.setCrop(crop(), { draft: true }); });
    }
  });
  const end = () => { if (drag) { drag = null; timed(() => preview.setCrop(crop())); } };
  canvas.addEventListener('pointerup', end);
  canvas.addEventListener('pointercancel', end);

  show(testCard());
</script>

<style>
  .bench { width: min(26rem, 100% - 2 * var(--edge)); margin: 1rem auto 0; display: grid; gap: .9rem; }
  canvas { width: 100%; height: auto; aspect-ratio: auto 84 / 102; border-radius: 1rem; touch-action: none; background: var(--night); }
  .note { min-height: 1.4em; margin: 0; color: var(--lantern); font: 1rem/1.4 var(--serif); }
  .seg { display: flex; padding: .2rem; border-radius: 99px; box-shadow: 0 0 0 1px var(--line); }
  .seg button { flex: 1; padding: .55rem .4rem; border: 0; border-radius: 99px; background: none; color: var(--muted); font: 600 .9rem/1 var(--sans); }
  .seg button[aria-pressed="true"] { background: var(--lantern); color: var(--night); }
  .zoom { display: flex; gap: .8rem; align-items: center; color: var(--muted); font: .9rem var(--sans); }
  .zoom input { flex: 1; accent-color: var(--lantern); }
  .row { display: flex; flex-wrap: wrap; gap: .6rem; }
  .row button, .pick { padding: .55rem .9rem; border: 0; border-radius: 99px; background: var(--deep); box-shadow: 0 0 0 1px var(--line); color: var(--text); font: .9rem/1.2 var(--sans); cursor: pointer; }
  .pick input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .timing { margin: 0; color: var(--faint); font: .8rem var(--mono); }
</style>
