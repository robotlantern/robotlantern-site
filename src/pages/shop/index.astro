---
// The shop: each listed product with its price and a button to its Stripe Payment Link
// (docs/SHOP.md). Products come from products/*/shop.json; only "listed": true shows here.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionIcon from '../../components/SectionIcon.astro';
import { SHOP_MODE } from '../../lib/shop';

const products = (await getCollection('shop')).filter((p) => p.data.listed);
for (const p of products) {
  if (!p.data.stripe[SHOP_MODE]?.url) throw new Error(`${p.id}: listed without a ${SHOP_MODE} Payment Link`);
}
const money = (n: number) => `$${n % 1 ? n.toFixed(2) : n}`;
---
<Base title="Shop" section="shop">
  {products.length ? (
    <main class="shop">
      {products.map((p) => (
        <article class="item">
          {p.data.images[0] && <img src={p.data.images[0]} alt="" loading="lazy" />}
          <h2>{p.data.name}</h2>
          {p.data.description && <p class="item__what">{p.data.description}</p>}
          <p class="item__price">{money(p.data.price)} <span>+ {money(p.data.shipping)} shipping</span></p>
          {p.data.fulfillment === 'self' && <p class="item__note">Made and shipped by RJ. Final sale.</p>}
          <a class="item__buy" href={p.data.stripe[SHOP_MODE]!.url}>Buy</a>
        </article>
      ))}
    </main>
  ) : (
    <main class="reading soon">
      <SectionIcon name="shop" />
      <h1>Shop</h1>
      <p>Prints and other goods will live here. Nothing here yet.</p>
    </main>
  )}
</Base>

<style>
  .soon { padding-block: 4rem 2rem; text-align: center; color: var(--muted); }
  .soon :global(.section-icon) { width: 3rem; height: 3rem; color: var(--lantern); }
  h1 { margin: .8rem 0 .6rem; color: var(--text); font: 400 2.4rem/1 var(--serif); }
  .shop { width: min(64rem, 100% - 2 * var(--edge)); margin: 2rem auto 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }
  .item { padding: 1.2rem; border-radius: 1.2rem; background: var(--night); box-shadow: 0 0 0 1px var(--line); }
  .item img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: .8rem; margin-bottom: 1rem; }
  h2 { margin: 0 0 .4rem; font: 400 1.6rem/1.1 var(--serif); }
  .item__what, .item__note { margin: 0 0 .8rem; color: var(--muted); font: 1rem/1.5 var(--serif); }
  .item__price { margin: 0 0 1rem; font: 1.1rem/1.4 var(--serif); }
  .item__price span { color: var(--muted); font-size: .9rem; }
  .item__buy { display: inline-block; padding: .75rem 1.5rem; border-radius: 99px; background: var(--lantern); color: var(--night); font: 700 .78rem/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; text-decoration: none; }
  .item__buy:hover { background: #fff0cf; }
</style>
