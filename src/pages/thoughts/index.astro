---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { shortDate } from '../../lib/authors';

const thoughts = (await getCollection('essays')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Thoughts" section="thoughts">
  <main class="reading index">
    <h1>Thoughts</h1>
    <ul>
      {thoughts.map((t) => (
        <li><a href={`/thoughts/${t.id}/`}>{t.data.title}</a><time datetime={t.data.date.toISOString().slice(0, 10)}>{shortDate(t.data.date)}</time></li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .index { padding-block: 2.5rem 1rem; }
  h1 { margin: 0 0 1.5rem; font: 400 2.4rem/1 var(--serif); }
  ul { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  a { color: var(--text); font: 400 1.35rem/1.3 var(--serif); text-decoration: none; }
  a:hover { color: var(--lantern); }
  time { color: var(--faint); font: .75rem/1 var(--sans); white-space: nowrap; }
</style>
