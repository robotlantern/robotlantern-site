---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import SectionMark from '../components/SectionMark.astro';

type Section = 'thoughts' | 'chats' | 'builds' | 'shop';
interface Props {
  title: string;
  description?: string;
  section?: Section;
}
const { title, description, section } = Astro.props;
const pageTitle = title === 'Robot Lantern' ? title : `${title} · Robot Lantern`;
const sections: { id: Section; label: string }[] = [
  { id: 'thoughts', label: 'Thoughts' },
  { id: 'chats', label: 'Chats' },
  { id: 'builds', label: 'Builds' },
  { id: 'shop', label: 'Shop' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description}>}
  <meta name="theme-color" content="#04060d">
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
  <slot name="head" />
</head>
<body>
  <header class="site-header">
    <a class="site-header__mark" href="/"><Wordmark /></a>
    <nav aria-label="Main">
      {sections.map((s) => (
        <a href={`/${s.id}/`} aria-current={section === s.id ? 'page' : undefined}>
          <span>{s.label}</span><i><SectionMark name={s.id} /></i>
        </a>
      ))}
    </nav>
  </header>
  <slot />
  <footer class="site-footer">
    <span>Robot Lantern</span>
    <a href="/authors/">Authors</a>
  </footer>
</body>
</html>

<style>
  /* The wordmark's top margin equals its left margin (docs/PAGES.md). */
  .site-header { position: relative; z-index: 10; display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; padding: var(--edge) var(--edge) 0; }
  .site-header__mark { display: block; width: 8.5rem; line-height: 0; flex: none; }
  .site-header__mark :global(.wordmark) { width: 100%; height: auto; overflow: visible; }
  /* Each section's name is followed by its mark, centered on the character cell after the word
     and larger than it (docs/HOME.md, "Section marks"). White label, the mark slightly dimmer. */
  nav { display: flex; gap: 1.4rem; }
  nav a { display: flex; align-items: center; min-height: 2.75rem; color: #f4f1ea; text-decoration: none; font: 700 .72rem/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; transition: color .2s; }
  nav a i { position: relative; display: inline-block; width: 1.9em; height: 1em; }
  nav a :global(.mark) { position: absolute; left: 50%; top: 50%; width: 1.7rem; height: 1.7rem; transform: translate(-50%, -50%); opacity: .88; }
  nav a:hover, nav a[aria-current='page'] { color: var(--lantern); }
  .site-footer { display: flex; justify-content: space-between; gap: 1rem; margin-top: 4rem; padding: 1.6rem var(--edge) 2.4rem; border-top: 1px solid var(--line); color: var(--faint); font: .7rem/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .site-footer a { color: var(--muted); text-decoration: none; }
  .site-footer a:hover { color: var(--lantern); }
  @media (max-width: 600px) {
    .site-header { flex-direction: column; gap: 1.1rem; }
    .site-header__mark { width: 7rem; }
    nav { width: 100%; justify-content: space-between; gap: .5rem; padding-right: .5rem; }
    nav a { font-size: .66rem; }
    nav a :global(.mark) { width: 1.5rem; height: 1.5rem; }
  }
</style>
