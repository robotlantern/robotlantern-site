---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import HeadMeta from '../components/HeadMeta.astro';
import SiteMenu from '../components/SiteMenu.astro';
import MenuButton from '../components/MenuButton.astro';
import { brand } from '../lib/brand';

type Section = 'thoughts' | 'chats' | 'builds' | 'shop';
interface Props {
  title: string;
  description?: string;
  section?: Section;
  // The page's canonical path, when it shows another page's content (/chats/ shows the newest chat).
  canonical?: string;
}
const { title, description, section, canonical } = Astro.props;
const aspect = (brand.twoLine.height + 8) / (brand.twoLine.width + 8);
const pageTitle = title === 'Robot Lantern' ? title : `${title} · Robot Lantern`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description}>}
  <meta name="theme-color" content="#0c1730">
  <link rel="canonical" href={new URL(canonical ?? Astro.url.pathname, Astro.site)}>
  <HeadMeta title={pageTitle} description={description} path={canonical ?? Astro.url.pathname} />
  <slot name="head" />
</head>
<body>
  <header class="site-header" style={`--aspect:${aspect.toFixed(4)}`}>
    <div class="site-header__spacer" aria-hidden="true"></div>
    <div class="brand-dock" data-dock>
      <a class="site-header__mark" href="/"><Wordmark collapses /></a>
    </div>
  </header>
  <MenuButton />
  <slot />
  <Footer />
  <BottomNav current={section} />
  <SiteMenu><slot name="menu" /></SiteMenu>
</body>
</html>

<style>
  /* The wordmark's top margin equals its left margin (docs/PAGES.md). It stays in the corner as
     the page scrolls, until it collapses into the logo, the menu button (SiteMenu.astro). The
     section nav is anchored at the bottom (BottomNav.astro). */
  .site-header { position: relative; z-index: 10; padding: var(--edge) var(--edge) 0; --mark-w: 8.5rem; }
  .site-header__spacer { width: var(--mark-w); aspect-ratio: 1 / var(--aspect); }
  .brand-dock { position: fixed; z-index: 30; top: var(--edge); left: var(--edge); width: var(--mark-w); }
  .site-header__mark { display: block; width: 100%; line-height: 0; }
  .site-header__mark :global(.wordmark) { width: 100%; height: auto; overflow: visible; }
  /* Room for the nav at the bottom. */
  :global(body) { padding-bottom: 5.4rem; }
  @media (max-width: 600px) {
    .site-header { --mark-w: 7rem; }
    :global(body) { padding-bottom: 7.3rem; }
  }
</style>
