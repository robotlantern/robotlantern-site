---
// A build (interactive) runs full screen, with no site header or footer. The only site chrome is
// a quiet way home in the top-left corner: the monogram in its tile.
import '../styles/global.css';
import Monogram from '../components/Monogram.astro';
import HeadMeta from '../components/HeadMeta.astro';

interface Props { title: string; description?: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title} · Robot Lantern</title>
  {description && <meta name="description" content={description}>}
  <meta name="theme-color" content="#04060d">
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
  <HeadMeta title={`${title} · Robot Lantern`} description={description} path={Astro.url.pathname} />
</head>
<body class="build-page">
  <a class="build-home" href="/" aria-label="Robot Lantern home"><Monogram /></a>
  <slot />
</body>
</html>

<style is:global>
  .build-page { margin: 0; min-height: 0; overflow: hidden; background: var(--night); }
  .build-page::before { display: none; }
</style>
<style>
  /* The monogram in its tile, as on the site once the wordmark has collapsed. */
  .build-home { position: fixed; z-index: 20; top: .55rem; left: .55rem; display: grid; place-items: center; width: 2.9rem; height: 2.9rem; border-radius: .9rem; background: rgba(8, 13, 28, .82); box-shadow: 0 0 0 1px rgba(190, 205, 235, .12); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); opacity: .85; transition: opacity .2s; }
  .build-home:hover, .build-home:focus-visible { opacity: 1; }
  .build-home :global(.monogram) { width: auto; height: 1.9rem; }
</style>
