---
// A section's list (Thoughts or Chats): newest first, with search and sort for chats. It shows in
// the reader's sidebar on wide screens and in the site menu on phones (Reader.astro keeps every
// copy's search, sort and current item in step).
import SectionIcon from './SectionIcon.astro';
import { shortDate } from '../lib/authors';
import type { FeedItem } from '../lib/feeds';

interface Props { section: 'chats' | 'thoughts'; label: string; feed: FeedItem[]; current: string; tools?: boolean; where: 'sidebar' | 'menu' }
const { section, label, feed, current, tools = false, where } = Astro.props;
---
<div class={`reader-list reader-list--${where}`} data-list>
  <a class="reader-list__head" href={`/${section}/`}><SectionIcon name={section} />{label}</a>
  {tools && (
    <div class="reader-list__tools">
    <input class="reader-list__search" type="search" placeholder="Search" aria-label={`Search ${label.toLowerCase()}`} data-search />
    <label class="reader-list__sort">
      <span>Sort</span>
      <select data-sort>
      <option value="posted">Newest posted</option>
      <option value="date">Newest chat</option>
      </select>
    </label>
    </div>
  )}
  <ul class="reader-list__items" data-items>
    {feed.map((f) => (
    <li data-posted={+f.posted} data-date={+f.date} data-text={f.search}>
      <a href={f.href} aria-current={f.id === current ? 'page' : undefined}>
      <span class="reader-list__title">{f.title}</span>
      <span class="reader-list__date">{shortDate(tools ? f.date : f.posted)}</span>
      </a>
    </li>
    ))}
  </ul>
  <p class="reader-list__none" data-none hidden>Nothing matches.</p>
</div>

<style>
  .reader-list__head { display: flex; align-items: center; gap: .5rem; padding: .4rem .85rem .8rem; color: var(--muted); font: 700 .7rem/1 var(--sans); letter-spacing: .14em; text-decoration: none; text-transform: uppercase; }
  .reader-list__head:hover { color: var(--lantern); }
  .reader-list__head :global(.section-icon) { width: 1.3rem; height: 1.3rem; color: var(--text); }
  .reader-list__tools { display: grid; gap: .5rem; padding: 0 .35rem .8rem; }
  .reader-list__search { width: 100%; padding: .55rem .8rem; border: 1px solid var(--line); border-radius: .7rem; background: rgba(190, 205, 235, .05); color: var(--text); font: .9rem/1.2 var(--sans); }
  .reader-list__search::placeholder { color: var(--faint); }
  .reader-list__sort { display: flex; align-items: center; justify-content: space-between; gap: .6rem; padding: 0 .3rem; color: var(--faint); font: .72rem/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; }
  .reader-list__sort select { padding: .3rem .4rem; border: 1px solid var(--line); border-radius: .5rem; background: var(--night-2); color: var(--muted); font: .8rem/1.2 var(--sans); letter-spacing: 0; text-transform: none; }

  .reader-list__items { margin: 0; padding: 0; list-style: none; display: grid; gap: .15rem; }
  .reader-list__items [hidden] { display: none; }
  .reader-list__items a { display: grid; gap: .2rem; padding: .7rem .85rem; border-radius: .8rem; color: var(--text); text-decoration: none; }
  .reader-list__items a:hover { background: rgba(190, 205, 235, .06); }
  .reader-list__items a[aria-current='page'] { background: rgba(190, 205, 235, .11); }
  .reader-list__title { overflow: hidden; font: 500 .95rem/1.3 var(--sans); text-overflow: ellipsis; white-space: nowrap; }
  .reader-list__date { color: var(--faint); font: .72rem/1 var(--sans); letter-spacing: .05em; }
  .reader-list__none { margin: .6rem .85rem; color: var(--faint); font: .85rem/1.4 var(--sans); }
  .reader-list__none[hidden] { display: none; }

  /* In the menu on phones only; wide screens have the sidebar. */
  @media (min-width: 901px) { .reader-list--menu { display: none; } }
</style>
