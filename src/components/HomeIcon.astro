---
// Home, in the menu only: the brand's ovaloid under a roof.
import { OVALOID, ovaloidAt, turnFor } from '../lib/brand';
---
<svg class="home-icon" viewBox="0 0 24 24" aria-hidden="true">
  <path d="M3.5 11 12 4l8.5 7" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
  <path d={OVALOID} fill="currentColor" transform={ovaloidAt(12, 15.6, 9.6, turnFor('home'))}/>
</svg>

<style>
  .home-icon { display: inline-block; width: 1.3em; height: 1.3em; vertical-align: middle; }
</style>
