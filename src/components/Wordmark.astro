---
// The wordmark, lit (RJ's design/brand/wordmark-*.svg via src/data/brand.json): the letters take
// the lantern's light and the period, the ovaloid, is the lantern. Two lines (left-aligned) or one.
// The "t" of "Lantern" and the period are grouped apart, because with the ovaloid beside it that
// "t" is the monogram (the menu button collapses into it).
import { brand } from '../lib/brand';

interface Props { layout?: 'two-line' | 'landscape'; class?: string }
const { layout = 'two-line', class: className } = Astro.props;
const w = layout === 'landscape' ? brand.landscape : brand.twoLine;
const tParts = new Set([w.t.hook, w.t.base]);
const rest = w.letters.filter((d) => !tParts.has(d));
const [px0, py0, px1, py1] = w.periodBox;
const cx = (px0 + px1) / 2, cy = (py0 + py1) / 2;
const id = `wm-${layout}`;
const pad = 4;
---
<svg class:list={['wordmark', className]} viewBox={`${-pad} ${-pad} ${w.width + pad * 2} ${w.height + pad * 2}`} role="img" aria-label="Robot Lantern">
  <defs>
    <radialGradient id={`${id}-light`} gradientUnits="userSpaceOnUse" cx={cx} cy={cy} r={w.width * .95}>
      <stop offset="0" stop-color="#ffd79a"/>
      <stop offset=".25" stop-color="#f6dbb0"/>
      <stop offset=".6" stop-color="#ddd5c4"/>
      <stop offset="1" stop-color="#b3bccf"/>
    </radialGradient>
    <radialGradient id={`${id}-glow`}>
      <stop offset="0" stop-color="#ffd68c" stop-opacity=".7"/>
      <stop offset=".35" stop-color="#ffa050" stop-opacity=".18"/>
      <stop offset="1" stop-color="#ff8c3c" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <circle class="wordmark__glow" cx={cx} cy={cy} r={(px1 - px0) * 2.4} fill={`url(#${id}-glow)`}/>
  <g fill={`url(#${id}-light)`}>
    <g class="wordmark__letters">{rest.map((d) => <path d={d}/>)}</g>
    <g class="wordmark__t"><path d={w.t.hook}/><path d={w.t.base}/></g>
  </g>
  <path class="wordmark__period" d={w.period} fill="#ffd28a"/>
</svg>
