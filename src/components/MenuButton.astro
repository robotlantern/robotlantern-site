---
// The menu button is the logo, in the top-left corner, centered in the bar that reading pages pin
// to the top. It appears once the wordmark has collapsed into it (SiteMenu.astro runs the collapse
// and the menu).
import Logo from './Logo.astro';
---
<button class="menu-button" type="button" aria-label="Menu" aria-controls="site-menu" aria-expanded="false" data-menu-open data-logo tabindex="-1"><Logo /></button>

<style>
  .menu-button {
    position: fixed; z-index: 31; left: var(--edge); top: calc((var(--bar-h) - var(--logo)) / 2);
    width: var(--logo); height: var(--logo); padding: 0; border: 0; border-radius: 18%;
    background: none; box-shadow: 0 2px 10px rgba(0, 0, 0, .45); cursor: pointer; visibility: hidden; line-height: 0;
  }
  .menu-button :global(.logo) { width: 100%; height: 100%; }
  .menu-button:focus-visible { outline: 2px solid var(--lantern); outline-offset: 3px; }
</style>
