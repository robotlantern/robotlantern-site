---
// The list of chats, like a chat app's sidebar. Newest first.
import { getCollection } from 'astro:content';
import { shortDate } from '../lib/authors';

interface Props { current?: string }
const { current } = Astro.props;
const chats = (await getCollection('conversations')).sort((a, b) => +b.data.date - +a.data.date);
---
<ul class="chat-list">
  {chats.map((c) => (
    <li>
      <a href={`/chats/${c.id}/`} aria-current={c.id === current ? 'page' : undefined}>
        <span class="chat-list__title">{c.data.title}</span>
        <span class="chat-list__date">{shortDate(c.data.date)}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .chat-list { margin: 0; padding: 0; list-style: none; display: grid; gap: .15rem; }
  .chat-list a { display: grid; gap: .2rem; padding: .7rem .85rem; border-radius: .8rem; color: var(--text); text-decoration: none; }
  .chat-list a:hover { background: rgba(190, 205, 235, .06); }
  .chat-list a[aria-current='page'] { background: rgba(190, 205, 235, .11); }
  .chat-list__title { overflow: hidden; font: 500 .95rem/1.3 var(--sans); text-overflow: ellipsis; white-space: nowrap; }
  .chat-list__date { color: var(--faint); font: .72rem/1 var(--sans); letter-spacing: .05em; }
</style>
