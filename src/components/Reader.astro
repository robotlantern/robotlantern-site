---
// List and detail, like a chat app: the section's list beside the reading column (in the site
// menu on phones), a small title that stays at the top, and an endless column. Near the end of a piece,
// the next one in reading order is fetched from its own page and appended; as each piece comes
// into view, the address, the page title, the small title and the list follow it.
//
// Each piece goes in the default slot as an element with data-entry, data-url and data-name,
// containing one [data-title] (its big title). Chats can sort by posted or chat date and search.
import ReaderList from './ReaderList.astro';
import type { FeedItem } from '../lib/feeds';

interface Props { section: 'chats' | 'thoughts'; label: string; feed: FeedItem[]; current: string; next?: FeedItem; tools?: boolean }
const { section, label, feed, current, next, tools = false } = Astro.props;
---
<div class="reader" data-reader>
  <aside class="reader__list" aria-label={label}>
    <ReaderList section={section} label={label} feed={feed} current={current} tools={tools} where="sidebar" />
  </aside>

  <main class="reader__main">
    <div class="reader__bar" data-bar>
      <p class="reader__bar-title" aria-hidden="true" data-bar-title></p>
    </div>
    <div class="reader__entries" data-entries>
      <slot />
    </div>
    {next && <div class="reader__more" data-next={next.href} aria-hidden="true"></div>}
  </main>
  <slot name="after" />
</div>

<style>
  .reader { --list: 17rem; display: grid; grid-template-columns: var(--list) minmax(0, 1fr); margin-top: 1rem; }
  /* The sidebar starts below the corner, where the collapsed monogram (the menu) sits. */
  .reader__list { position: sticky; top: 0; align-self: start; height: 100vh; overflow: auto; padding: 3.6rem .7rem 2rem var(--edge); border-right: 1px solid var(--line); }
  .reader__main { --pad-left: var(--edge); min-width: 0; padding: 0 var(--edge) 0 var(--pad-left); }

  /* The small title stays at the top once the first big one scrolls away. */
  .reader__bar { position: sticky; top: 0; z-index: 8; display: flex; align-items: center; gap: .6rem; height: 3.2rem; margin: 0 calc(-1 * var(--edge)) 0 calc(-1 * var(--pad-left)); padding: 0 var(--edge) 0 max(var(--pad-left), 4.2rem); transition: background .2s; }
  .reader__bar-title { margin: 0 auto; max-width: 46rem; flex: 1; overflow: hidden; padding: .2em 0; font: 400 1.1rem/1.3 var(--serif); text-overflow: ellipsis; white-space: nowrap; opacity: 0; transform: translateY(.4rem); transition: opacity .2s, transform .2s; }
  .reader.is-stuck .reader__bar { background: rgba(4, 6, 13, .86); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); box-shadow: 0 1px 0 var(--line); }
  .reader.is-stuck .reader__bar-title { opacity: 1; transform: none; }

  /* Between pieces, a quiet break. */
  .reader__entries > :global([data-entry] + [data-entry]) { margin-top: 5rem; padding-top: 4rem; border-top: 1px solid var(--line); }
  .reader__more { height: 1px; }

  @media (max-width: 900px) {
    .reader { grid-template-columns: minmax(0, 1fr); margin-top: .4rem; }
    .reader__list { display: none; }
    .reader__main { padding-right: calc(var(--edge) + .5rem); }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-reader]')!;
  const entries = root.querySelector<HTMLElement>('[data-entries]')!;
  const barTitle = root.querySelector<HTMLElement>('[data-bar-title]')!;
  const links = () => [...document.querySelectorAll<HTMLAnchorElement>('[data-list] [data-items] a')];

  // The small title appears once the first big title has scrolled under the bar.
  const firstTitle = root.querySelector('[data-title]');
  if (firstTitle) {
    new IntersectionObserver(([e]) => root.classList.toggle('is-stuck', !e.isIntersecting && e.boundingClientRect.top < 0), {
      rootMargin: '-52px 0px 0px 0px',
    }).observe(firstTitle);
  }

  // The piece in view: the one crossing a line a third of the way down the screen.
  let current: HTMLElement | null = null;
  const setCurrent = (entry: HTMLElement) => {
    if (entry === current) return;
    const first = !current;
    current = entry;
    barTitle.textContent = entry.dataset.name ?? '';
    const url = entry.dataset.url!;
    if (!first && location.pathname !== url) history.replaceState(null, '', url);
    if (!first) document.title = `${entry.dataset.name} · Robot Lantern`;
    for (const a of links()) {
      if (new URL(a.href).pathname === url) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    }
    root.dispatchEvent(new CustomEvent('reader:entry', { detail: entry }));
  };
  const watcher = new IntersectionObserver((seen) => {
    for (const e of seen) if (e.isIntersecting) setCurrent(e.target as HTMLElement);
  }, { rootMargin: '-33% 0px -66% 0px' });
  const watch = (el: HTMLElement) => watcher.observe(el);
  entries.querySelectorAll<HTMLElement>('[data-entry]').forEach(watch);
  const firstEntry = entries.querySelector<HTMLElement>('[data-entry]');
  if (firstEntry) setCurrent(firstEntry);

  // Endless reading: fetch the next piece's page when the end is near and append its piece.
  let more = root.querySelector<HTMLElement>('[data-next]');
  let loading = false;
  const loadNext = async () => {
    if (!more || loading) return;
    loading = true;
    try {
      const html = await (await fetch(more.dataset.next!)).text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const entry = doc.querySelector<HTMLElement>('[data-entry]');
      if (!entry) throw new Error('no piece on ' + more.dataset.next);
      const next = doc.querySelector<HTMLElement>('[data-next]')?.dataset.next;
      const adopted = document.importNode(entry, true);
      entries.append(adopted);
      watch(adopted);
      root.dispatchEvent(new CustomEvent('reader:append', { detail: adopted }));
      if (next) more.dataset.next = next;
      else { endless.disconnect(); more.remove(); more = null; }
    } catch (err) {
      console.warn('[reader]', err);
      endless.disconnect();
    } finally {
      loading = false;
    }
  };
  const endless = new IntersectionObserver(([e]) => { if (e.isIntersecting) loadNext(); }, { rootMargin: '0px 0px 1200px 0px' });
  if (more) endless.observe(more);

  // Search and sort (chats), in each copy of the list.
  for (const box of document.querySelectorAll<HTMLElement>('[data-list]')) {
    const search = box.querySelector<HTMLInputElement>('[data-search]');
    const sort = box.querySelector<HTMLSelectElement>('[data-sort]');
    const list = box.querySelector<HTMLElement>('[data-items]')!;
    const none = box.querySelector<HTMLElement>('[data-none]')!;
    const refine = () => {
      const q = (search?.value ?? '').trim().toLowerCase();
      const items = [...list.children] as HTMLElement[];
      const key = sort?.value === 'date' ? 'date' : 'posted';
      items.sort((a, b) => Number(b.dataset[key]) - Number(a.dataset[key])).forEach((li) => list.append(li));
      let shown = 0;
      for (const li of items) {
        const hit = !q || q.split(/\s+/).every((w) => li.dataset.text!.includes(w));
        li.hidden = !hit;
        shown += Number(hit);
      }
      none.hidden = shown > 0;
    };
    search?.addEventListener('input', refine);
    sort?.addEventListener('change', refine);
  }
</script>
