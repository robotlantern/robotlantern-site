---
// The monogram on its own (RJ's design/brand/monogram-logo-bw.svg): the wordmark's "t" halves and
// the ovaloid, in the wordmark's colors. Used where there's no wordmark to collapse (builds).
import { brand } from '../lib/brand';

const m = brand.monogram;
---
<svg class="monogram" viewBox={`-2 -2 ${m.width + 4} ${m.height + 4}`} role="img" aria-label="Robot Lantern">
  <path d={m.hook} fill="#e9e2d2"/><path d={m.base} fill="#e9e2d2"/><path d={m.dot} fill="#ffd28a"/>
</svg>
