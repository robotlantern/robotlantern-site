---
// Small icons, drawn for this site. People and models are solid glyphs; the section and
// interface icons are strokes. All use currentColor.
interface Props {
  name: 'person' | 'robot' | 'thoughts' | 'chats' | 'builds' | 'shop' | 'menu' | 'close';
  class?: string;
}
const { name, class: className } = Astro.props;
const solid = name === 'person' || name === 'robot';
---
<svg
  class:list={['icon', `icon--${name}`, className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill={solid ? 'currentColor' : 'none'}
  stroke={solid ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'person' && (
    <>
      <circle cx="12" cy="7" r="3.8" />
      <path d="M4.5 21v-1.8a7.5 7.5 0 0 1 15 0V21z" />
    </>
  )}
  {name === 'robot' && (
    <>
      <circle cx="12" cy="3.2" r="1.5" />
      <rect x="11.3" y="4.4" width="1.4" height="3" />
      <rect x="1.8" y="11" width="2" height="4.8" rx="1" />
      <rect x="20.2" y="11" width="2" height="4.8" rx="1" />
      <path
        fill-rule="evenodd"
        d="M7.5 7h9a3.5 3.5 0 0 1 3.5 3.5v6a3.5 3.5 0 0 1-3.5 3.5h-9A3.5 3.5 0 0 1 4 16.5v-6A3.5 3.5 0 0 1 7.5 7zM9 10.9a1.7 1.7 0 1 0 0 3.4a1.7 1.7 0 1 0 0-3.4zM15 10.9a1.7 1.7 0 1 0 0 3.4a1.7 1.7 0 1 0 0-3.4zM9 16.1h6v1.5H9z"
      />
    </>
  )}
  {name === 'thoughts' && (
    <>
      <path d="M8.2 15.2h8.3a3.5 3.5 0 0 0 .6-6.95 4.6 4.6 0 0 0-8.8-1.3 4.1 4.1 0 0 0-.1 8.25z" />
      <circle cx="6.2" cy="18.4" r="1.3" />
      <circle cx="3.7" cy="20.9" r=".7" />
    </>
  )}
  {name === 'chats' && (
    <>
      <path d="M4.2 4.5h10.3a2.2 2.2 0 0 1 2.2 2.2v5.6a2.2 2.2 0 0 1-2.2 2.2H9.2L5.6 17.6v-3.1H4.2A2.2 2.2 0 0 1 2 12.3V6.7a2.2 2.2 0 0 1 2.2-2.2z" />
      <path d="M19.4 9.2h.4A2.2 2.2 0 0 1 22 11.4v5.1a2.2 2.2 0 0 1-2.2 2.2h-.9v2.8l-3.3-2.8h-3.3a2.2 2.2 0 0 1-2.1-1.5" />
    </>
  )}
  {name === 'builds' && (
    <>
      <rect x="2.8" y="13.2" width="8.4" height="7.3" rx="1.2" />
      <rect x="12.8" y="13.2" width="8.4" height="7.3" rx="1.2" />
      <rect x="7.8" y="4.2" width="8.4" height="7.3" rx="1.2" />
    </>
  )}
  {name === 'shop' && (
    <>
      <path d="M4.6 8.2h14.8l-1.1 11.6a1.6 1.6 0 0 1-1.6 1.4H7.3a1.6 1.6 0 0 1-1.6-1.4z" />
      <path d="M8.8 10.6V6.8a3.2 3.2 0 0 1 6.4 0v3.8" />
    </>
  )}
  {name === 'menu' && <path d="M4 8.5h16M4 15.5h11" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
</svg>
