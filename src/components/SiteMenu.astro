---
// The site menu, the same on every page: Home, the four sections and the footer pages, plus
// whatever the page adds in the default slot (Thoughts and Chats add their list and search).
// It opens from the logo. The script also runs the collapse: once the reader scrolls, the
// wordmark collapses into the logo, which is the menu button (docs/BRAND.md, docs/HOME.md).
import SectionIcon from './SectionIcon.astro';
import Wordmark from './Wordmark.astro';
import HomeIcon from './HomeIcon.astro';
import Icon from './Icon.astro';

const sections = [['thoughts', 'Thoughts'], ['chats', 'Chats'], ['builds', 'Builds'], ['shop', 'Shop']] as const;
const more = [['/about/', 'About'], ['/authors/', 'Authors'], ['/credits/', 'Credits'], ['/terms/', 'Terms'], ['/privacy/', 'Privacy']];
const here = Astro.url.pathname;
const current = (href: string) => (href === '/' ? here === '/' : here.startsWith(href)) ? 'page' : undefined;
---
<div class="site-menu" id="site-menu" data-menu>
  <button class="site-menu__backdrop" type="button" tabindex="-1" aria-label="Close the menu" data-menu-close></button>
  <div class="site-menu__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="site-menu__head">
      <a class="site-menu__wordmark" href="/"><Wordmark layout="landscape" /></a>
      <button class="site-menu__close" type="button" aria-label="Close" data-menu-close><Icon name="close" /></button>
    </div>
    <nav class="site-menu__main" aria-label="Site">
      <a href="/" aria-current={current('/')}><HomeIcon />Home</a>
      {sections.map(([id, label]) => <a href={`/${id}/`} aria-current={current(`/${id}/`)}><SectionIcon name={id} />{label}</a>)}
    </nav>
    <div class="site-menu__extra"><slot /></div>
    <nav class="site-menu__more" aria-label="About this site">
      {more.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
    </nav>
  </div>
</div>

<style>
  .site-menu { position: fixed; inset: 0; z-index: 40; visibility: hidden; }
  .site-menu.is-open { visibility: visible; }
  .site-menu__backdrop { position: absolute; inset: 0; border: 0; background: rgba(0, 0, 0, .55); opacity: 0; transition: opacity .22s; }
  .site-menu.is-open .site-menu__backdrop { opacity: 1; }
  .site-menu__panel { position: absolute; inset: 0 auto 0 0; display: flex; flex-direction: column; gap: 1.2rem; width: min(21rem, calc(100vw - 3rem)); overflow: auto; padding: .8rem 1rem 1.6rem; background: var(--night-2, #080f21); box-shadow: 1rem 0 3rem rgba(0, 0, 0, .5); transform: translateX(-105%); transition: transform .22s ease; }
  .site-menu.is-open .site-menu__panel { transform: none; }
  .site-menu__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-left: .8rem; }
  .site-menu__wordmark { display: block; line-height: 0; }
  .site-menu__wordmark :global(.wordmark) { width: 9.5rem; height: auto; overflow: visible; }
  .site-menu__close { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; padding: 0; border: 0; border-radius: 50%; background: rgba(190, 205, 235, .08); color: var(--text); cursor: pointer; }
  .site-menu__close :global(.icon) { width: 1.1rem; height: 1.1rem; }
  .site-menu__main { display: grid; gap: .1rem; }
  .site-menu__main a { display: flex; align-items: center; gap: .8rem; padding: .7rem .8rem; border-radius: .8rem; color: var(--text); font: 700 .8rem/1 var(--sans, system-ui); letter-spacing: .14em; text-transform: uppercase; text-decoration: none; }
  .site-menu__main a:hover { background: rgba(190, 205, 235, .06); }
  .site-menu__main a[aria-current='page'] { background: rgba(190, 205, 235, .11); color: var(--lantern); }
  .site-menu__main :global(.section-icon), .site-menu__main :global(.home-icon) { width: 1.5rem; height: 1.5rem; }
  .site-menu__extra:empty { display: none; }
  .site-menu__extra { padding-top: .4rem; border-top: 1px solid var(--line); }
  .site-menu__more { display: flex; flex-wrap: wrap; gap: .7rem 1.2rem; margin-top: auto; padding: 1rem .8rem 0; border-top: 1px solid var(--line); }
  .site-menu__more a { color: var(--muted); font: .72rem/1 var(--sans, system-ui); letter-spacing: .12em; text-transform: uppercase; text-decoration: none; }
  .site-menu__more a:hover, .site-menu__more a[aria-current='page'] { color: var(--lantern); }
  /* The collapse's frames are drawn over everything; the wordmark hides while they run. */
  :global(.collapse-fly) { position: fixed; z-index: 32; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; visibility: hidden; }
  :global([data-dock].is-collapsed) { visibility: hidden; }
  @media (prefers-reduced-motion: reduce) { .site-menu__panel, .site-menu__backdrop { transition: none; } }
</style>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const openers = () => [...document.querySelectorAll<HTMLButtonElement>('[data-menu-open]')];
  let returnTo: HTMLElement | null = null;
  const setOpen = (open: boolean) => {
    menu.classList.toggle('is-open', open);
    openers().forEach((b) => b.setAttribute('aria-expanded', String(open)));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) {
      returnTo = document.activeElement as HTMLElement;
      menu.querySelector<HTMLElement>('[aria-current="page"], a')?.focus();
    } else returnTo?.focus();
  };
  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    if (t.closest('[data-menu-open]')) setOpen(true);
    else if (t.closest('[data-menu-close]')) setOpen(false);
  });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.classList.contains('is-open')) setOpen(false); });

  // The collapse (docs/BRAND.md). Once the reader scrolls past a [data-dock]'s data-collapse-start
  // (px; the home page sets it to the moment its wordmark has landed), the wordmark collapses into
  // the logo in a few quick frames, and opens out again on the way back up. It's timed, not tied
  // to the scroll, so it never rests half done. In the first frame the whole wordmark turns into
  // the tile's cream, a rounded block where the letters were; each frame it shrinks toward the
  // logo, and the t's halves and the period ride on it to their places, the lower half turning as
  // it goes. So every frame is a whole tile, never letters half gone.
  const FRAMES = 4, FRAME_MS = 45, PAST = 24;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const logo = document.querySelector<HTMLElement>('[data-logo]');
  const NS = 'http://www.w3.org/2000/svg';
  type Part = [string, number[], number[], number, string];
  const docks = logo ? [...document.querySelectorAll<HTMLElement>('[data-dock]')].map((dock) => {
    const svg = dock.querySelector<SVGSVGElement>('[data-collapse]')!;
    const { vb, parts } = JSON.parse(svg.dataset.collapse!) as { vb: number[]; parts: Part[] };
    const fly = document.createElementNS(NS, 'svg');
    fly.setAttribute('class', 'collapse-fly');
    fly.setAttribute('aria-hidden', 'true');
    const block = fly.appendChild(document.createElementNS(NS, 'rect'));
    block.setAttribute('fill', '#f4f1ea');
    const paths = parts.map(([d, , , , color]) => {
      const el = fly.appendChild(document.createElementNS(NS, 'path'));
      el.setAttribute('d', d);
      el.setAttribute('fill', color);
      return el;
    });
    document.body.append(fly);
    return { dock, svg, vb, parts, fly, block, paths, frame: 0, target: 0, timer: 0 };
  }) : [];
  type Dock = (typeof docks)[number];
  const center = (b: number[]) => [(b[0] + b[2]) / 2, (b[1] + b[3]) / 2];
  const draw = (d: Dock) => {
    const u = d.frame / FRAMES, mid = d.frame > 0 && d.frame < FRAMES;
    d.dock.classList.toggle('is-collapsed', d.frame > 0);
    logo!.style.visibility = d.frame === FRAMES ? 'visible' : '';
    logo!.tabIndex = d.frame === FRAMES ? 0 : -1;
    d.fly.style.visibility = mid ? 'visible' : 'hidden';
    if (!mid) return;
    // The wordmark's box as laid out (its dock may be scaled, as on the home page), and the logo's.
    const box = d.dock.getBoundingClientRect();
    const L = { x: logo!.offsetLeft, y: logo!.offsetTop, s: logo!.offsetWidth / 100 };
    const s0 = box.width / d.vb[2];
    const mix = (a: number, b: number) => a + (b - a) * u;
    const w = mix(box.width, 100 * L.s), h = mix(box.height, 100 * L.s);
    d.block.setAttribute('x', mix(box.left, L.x).toFixed(1));
    d.block.setAttribute('y', mix(box.top, L.y).toFixed(1));
    d.block.setAttribute('width', w.toFixed(1));
    d.block.setAttribute('height', h.toFixed(1));
    d.block.setAttribute('rx', (Math.min(w, h) * .18).toFixed(1));
    d.parts.forEach(([, from, to, turn], i) => {
      const [fx, fy] = center(from), [tx, ty] = center(to);
      const a = [box.left + (fx - d.vb[0]) * s0, box.top + (fy - d.vb[1]) * s0];
      const b = [L.x + tx * L.s, L.y + ty * L.s];
      const s1 = L.s * Math.sqrt(((to[2] - to[0]) * (to[3] - to[1])) / ((from[2] - from[0]) * (from[3] - from[1])));
      d.paths[i].setAttribute('transform', `translate(${mix(a[0], b[0]).toFixed(1)} ${mix(a[1], b[1]).toFixed(1)}) rotate(${turn * u}) scale(${mix(s0, s1).toFixed(4)}) translate(${-fx} ${-fy})`);
    });
  };
  const step = (d: Dock) => {
    d.timer = 0;
    if (d.frame === d.target) return;
    d.frame += d.target > d.frame ? 1 : -1;
    draw(d);
    if (d.frame !== d.target) d.timer = window.setTimeout(() => step(d), FRAME_MS);
  };
  let queued = false;
  const collapse = () => {
    queued = false;
    for (const d of docks) {
      const start = Number(d.dock.dataset.collapseStart ?? 0) + PAST;
      // A little give, so stopping right at the line doesn't flicker.
      const want = scrollY > (d.target ? start - 12 : start) ? FRAMES : 0;
      if (want !== d.target) {
        d.target = want;
        if (reduced) { d.frame = want; draw(d); }
        else if (!d.timer) step(d);
      } else if (d.frame) draw(d);
    }
  };
  const queue = () => { if (!queued) { queued = true; requestAnimationFrame(collapse); } };
  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', queue);
  addEventListener('rl:collapse', queue);
  collapse();
</script>
