---
// A section's mark in the nav (docs/HOME.md, "Section marks"): a dashed shape with one bright
// star on it, sized to sit behind the character cell after the section's name. Thoughts is
// the star alone, as an asterisk. Each outline starts at its star and has the same number of
// dashes (pathLength), so all four share one rhythm.
interface Props { name: 'thoughts' | 'chats' | 'builds' | 'shop' }
const { name } = Astro.props;

// Shapes in a 24-unit box centered on 12,12. `star` is the vertex that carries the star.
const polygon = (pts: number[][]) => 'M' + pts.map((p) => p.join(' ')).join('L') + 'Z';
const pentagon = [0, 1, 2, 3, 4].map((i) => {
  const a = (-90 + i * 72) * (Math.PI / 180);
  return [Math.round((12 + 10 * Math.cos(a)) * 100) / 100, Math.round((12.8 + 10 * Math.sin(a)) * 100) / 100];
});
const q = 12 + 9 * Math.SQRT1_2; // the circle's upper-right point, where its star sits
const p = 12 - 9 * Math.SQRT1_2;
const shapes = {
  // Maia, in the Pleiades: Hermes' mother.
  chats: { d: `M${q} ${p}A9 9 0 1 1 ${q - 0.001} ${p - 0.001}`, star: [q, p] },
  // Capella, Auriga's brightest: Erichthonius, son of Hephaestus.
  builds: { d: polygon(pentagon), star: pentagon[0] },
  // Aldebaran, the bull's eye: Taurus, Venus's sign, and Europa of the Phoenician traders.
  shop: { d: polygon([[20, 12], [12, 22.5], [4, 12], [12, 1.5]]), star: [20, 12] },
};
const shape = name === 'thoughts' ? null : shapes[name];
const r2 = (n: number) => Math.round(n * 100) / 100;
---
<svg class={`mark mark--${name}`} viewBox="0 0 24 24" aria-hidden="true">
  {shape ? (
    <>
      <path class="mark__line" d={shape.d} pathLength="24" />
      <g class="mark__star" transform={`translate(${r2(shape.star[0])} ${r2(shape.star[1])})`}>
        <circle class="mark__glow" r="3.6" />
        <path d="M0-3.4L.7-.7 3.4 0 .7.7 0 3.4-.7.7-3.4 0-.7-.7Z" />
      </g>
    </>
  ) : (
    <g class="mark__star mark__asterisk" transform="translate(12 12)">
      <circle class="mark__glow" r="7" />
      {[90, 30, -30].map((a) => <line x1="0" y1="-8.5" x2="0" y2="8.5" transform={`rotate(${a})`} />)}
    </g>
  )}
</svg>

<style>
  .mark { display: block; overflow: visible; color: inherit; }
  .mark__line { fill: none; stroke: currentColor; stroke-width: 1.3; stroke-dasharray: 1 1; stroke-linecap: butt; opacity: .85; }
  .mark__star { fill: currentColor; animation: mark-twinkle 3.2s ease-in-out infinite alternate; }
  .mark__glow { fill: currentColor; opacity: .18; }
  .mark__asterisk line { stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }
  .mark--chats .mark__star { animation-delay: -.8s; }
  .mark--builds .mark__star { animation-delay: -1.9s; }
  .mark--shop .mark__star { animation-delay: -2.7s; }
  @keyframes mark-twinkle { from { opacity: .55; } to { opacity: 1; } }
</style>
