---
// The chat's position, as faint dashes along the right edge, colored by speaker. They cover the
// chat in view, bulge where the reader is, and jump on tap or drag (docs/PAGES.md).
---
<div class="dashes" role="slider" tabindex="0" aria-label="Position in this chat" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-dashes></div>

<style>
  /* Position: faint dashes along the right edge, colored by speaker. */
  .dashes { position: fixed; z-index: 7; right: 0; top: calc(50% + 1.6rem); display: flex; flex-direction: column; align-items: flex-end; gap: 3px; width: 2rem; padding: .5rem 0; transform: translateY(-50%); cursor: pointer; touch-action: none; opacity: 0; visibility: hidden; transition: opacity .25s, visibility .25s; }
  /* The dashes appear once the title is under the bar, so they never cross the header. */
  :global(.reader.is-stuck) .dashes { opacity: 1; visibility: visible; }
  .dashes:focus-visible { outline-offset: 0; }
  .dashes :global(i) { display: block; width: 6px; height: 3px; border-radius: 2px 0 0 2px; }
  .dashes :global(i.human) { background: var(--bubble-human); }
  .dashes :global(i.ai) { background: var(--ai); }

</style>

<script>
  // Dashes: one run per message, sized by its length. The reader's position is a line that
  // moves from just under the bar (top of the page) to the bottom of the screen (end of the
  // page), so every dash can be reached.
  const root = document.querySelector<HTMLElement>('[data-reader]')!;
  const col = root.querySelector<HTMLElement>('[data-dashes]')!;
  const bar = root.querySelector<HTMLElement>('[data-bar]')!;
  // The chat in view (Reader.astro says which); the dashes cover its messages only.
  let chat = root.querySelector<HTMLElement>('[data-entry]')!;
  let msgs = [...chat.querySelectorAll<HTMLElement>('[data-speaker]')];
  let dashes: { el: HTMLElement; y: number; msg: number }[] = [];
  let end = 0;

  const build = () => {
    const tops = msgs.map((m) => m.getBoundingClientRect().top + scrollY);
    const heights = msgs.map((m) => m.offsetHeight);
    const total = heights.reduce((a, b) => a + b, 0) || 1;
    const target = Math.max(20, Math.min(70, Math.floor((innerHeight * 0.6) / 6)));
    col.replaceChildren();
    dashes = [];
    msgs.forEach((m, i) => {
      const n = Math.max(1, Math.round((heights[i] / total) * target));
      for (let k = 0; k < n; k++) {
        const el = document.createElement('i');
        el.className = m.dataset.speaker!;
        col.append(el);
        dashes.push({ el, y: tops[i] + (heights[i] * k) / n, msg: i });
      }
    });
    end = tops.at(-1)! + heights.at(-1)!;
    update();
  };

  // The chat's own scroll range: from its top under the bar to its end at the bottom of the
  // screen. Across it, the reading line moves from under the bar to the bottom of the screen.
  const range = () => {
    const top = chat.getBoundingClientRect().top + scrollY - bar.offsetHeight;
    const bottom = Math.min(document.documentElement.scrollHeight, chat.getBoundingClientRect().bottom + scrollY) - innerHeight;
    return [Math.max(0, top), Math.max(Math.max(0, top) + 1, bottom)];
  };
  const progress = (s: number) => { const [a, b] = range(); return Math.min(1, Math.max(0, (s - a) / (b - a))); };
  const probeFor = (s: number) => s + bar.offsetHeight + (innerHeight - bar.offsetHeight) * progress(s);
  const scrollFor = (y: number) => {
    const [a, b] = range(); const k = (innerHeight - bar.offsetHeight) / (b - a);
    return (y - bar.offsetHeight + k * a) / (1 + k);
  };

  const indexAt = (probe: number) => {
    if (!dashes.length || probe <= dashes[0].y) return 0;
    for (let j = 0; j < dashes.length; j++) {
      const next = j + 1 < dashes.length ? dashes[j + 1].y : end;
      if (probe < next) return j + (probe - dashes[j].y) / Math.max(1, next - dashes[j].y);
    }
    return dashes.length - 1;
  };
  const yAt = (f: number) => {
    const j = Math.max(0, Math.min(dashes.length - 1, Math.floor(f)));
    const next = j + 1 < dashes.length ? dashes[j + 1].y : end;
    return dashes[j].y + (next - dashes[j].y) * Math.min(1, Math.max(0, f - j));
  };

  let frame = 0;
  const update = () => {
    frame = 0;
    const f = indexAt(probeFor(scrollY));
    for (let j = 0; j < dashes.length; j++) {
      const g = Math.exp(-((j - f) ** 2) / 8);
      const s = dashes[j].el.style;
      s.width = `${6 + 16 * g}px`;
      s.height = `${3 + 3 * g}px`;
      s.opacity = String(0.2 + 0.3 * g);
    }
    col.setAttribute('aria-valuenow', String(Math.round(progress(scrollY) * 100)));
  };
  const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
  addEventListener('scroll', schedule, { passive: true });

  let rebuild = 0;
  const resized = new ResizeObserver(() => { cancelAnimationFrame(rebuild); rebuild = requestAnimationFrame(build); });
  resized.observe(root.querySelector('[data-entries]')!);
  addEventListener('resize', build);
  root.addEventListener('reader:entry', (e) => {
    chat = (e as CustomEvent<HTMLElement>).detail;
    msgs = [...chat.querySelectorAll<HTMLElement>('[data-speaker]')];
    build();
  });

  // Tap or drag on the column to jump.
  const seek = (clientY: number) => {
    const box = col.getBoundingClientRect();
    const f = ((clientY - box.top) / box.height) * dashes.length - 0.5;
    scrollTo({ top: scrollFor(yAt(Math.max(0, f))) });
  };
  let dragging = false;
  col.addEventListener('pointerdown', (e) => { dragging = true; col.setPointerCapture(e.pointerId); seek(e.clientY); });
  col.addEventListener('pointermove', (e) => { if (dragging) seek(e.clientY); });
  col.addEventListener('pointerup', () => { dragging = false; });
  col.addEventListener('keydown', (e) => {
    const f = indexAt(probeFor(scrollY));
    const current = dashes[Math.min(dashes.length - 1, Math.round(f))]?.msg ?? 0;
    const to = (i: number) => msgs[Math.max(0, Math.min(msgs.length - 1, i))];
    const target =
      e.key === 'ArrowDown' ? to(current + 1) : e.key === 'ArrowUp' ? to(current - 1) :
      e.key === 'Home' ? to(0) : e.key === 'End' ? to(msgs.length - 1) : null;
    if (!target) return;
    e.preventDefault();
    scrollTo({ top: scrollFor(target.getBoundingClientRect().top + scrollY) });
  });
</script>
