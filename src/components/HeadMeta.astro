---
// Icons and link-preview tags for every page (made by tools/brand/make_icons.py; docs/BRAND.md).
interface Props { title: string; description?: string; path: string }
const { title, description = 'Thoughts, chats, builds and a shop, from sunset into night.', path } = Astro.props;
const url = new URL(path, Astro.site);
const image = new URL('/og.png', Astro.site);
---
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:site_name" content="Robot Lantern">
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={image}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
