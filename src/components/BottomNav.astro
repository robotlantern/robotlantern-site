---
// The section nav, anchored at the bottom of the screen on every page: a dark bar floating over
// the content, each section's name with its mark. On the home page it appears once the wordmark
// has landed (the page styles .dock-nav); everywhere else it's there from the start.
import SectionMark from './SectionMark.astro';
import { markReach, type Section } from '../lib/section-marks';

interface Props { current?: Section; class?: string }
const { current, class: className } = Astro.props;
const sections: [Section, string][] = [['thoughts', 'Thoughts'], ['chats', 'Chats'], ['builds', 'Builds'], ['shop', 'Shop']];
---
<nav class:list={['bottom-nav', className]} aria-label="Main">
  {sections.map(([id, label]) => (
    <a href={`/${id}/`} aria-current={current === id ? 'page' : undefined} style={`--reach:${markReach(id).toFixed(2)}em`}>
      <span class="nav-label">{label}<SectionMark name={id} /></span>
    </a>
  ))}
</nav>

<style>
  /* Above Safari's address bar on phones, which floats over the bottom of the screen. */
  .bottom-nav {
    --pill: 0px;
    position: fixed; z-index: 20; left: 0; right: 0; bottom: 0;
    display: flex; justify-content: center; gap: 1.2rem;
    padding: .95rem var(--edge) calc(.95rem + var(--pill) + env(safe-area-inset-bottom, 0px));
    background: rgba(4, 6, 13, .82); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    box-shadow: 0 -1px 0 var(--line, rgba(190, 205, 235, .16));
  }
  .bottom-nav a { display: flex; align-items: center; min-height: 2.75rem; padding-right: calc(var(--reach, 1em) - .14em + .3em); color: #f4f1ea; text-decoration: none; font: 700 .72rem/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; transition: color .2s; }
  .nav-label { position: relative; line-height: 1; --mark-tracking: .14em; }
  .bottom-nav a:hover, .bottom-nav a[aria-current='page'] { color: var(--lantern); }
  @media (max-width: 600px) {
    .bottom-nav { --pill: 1.9rem; justify-content: space-between; gap: .5rem; }
    .bottom-nav a { font-size: .66rem; }
  }
</style>
